{
  "manifest_version": 3,
  "name": "Xưởng Truyện — ChatGPT Bridge",
  "version": "1.0.0",
  "description": "Kết nối Xưởng Truyện local với tab ChatGPT để viết, dịch và rà soát. Không API key.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Xưởng Truyện × ChatGPT"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:7872/*",
        "http://127.0.0.1:7872/*"
      ],
      "js": [
        "studio-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "chatgpt-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}